<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme for the single Activity. Compose draws everything; this theme
      only needs to be an ActionBar-less platform theme so there is no
      dependency on AppCompat.
    -->
    <style name="Theme.XbtWallet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/xbt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
